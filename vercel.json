{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist-api/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/xbox/submit/(.*)", "destination": "/xbox-preview.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
